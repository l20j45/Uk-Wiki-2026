---
import LiveClock from "@components/LiveClock";

const { greeting, username, headerClass, accentColor, clockGradient, londonHour } = Astro.props;


---

<header class={`relative overflow-hidden pt-8 pb-10 px-4 rounded-b-[3rem] shadow-2xl bg-gradient-to-b ${headerClass}`}>
  <div class="max-w-7xl mx-auto flex flex-col gap-6 relative z-10">
    <div class="flex justify-between items-start">
      <div class="space-y-2">
        <h1 class={`text-2xl md:text-3xl font-black leading-none ${londonHour >= 20 || londonHour < 6 ? "text-white" : "text-slate-900"}`}>
          {greeting}, <span class={accentColor}>{username}</span>! 👋
        </h1>

        <div class="flex items-center gap-2 ml-1">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
            Live UK Update
          </p>
        </div>
      </div>

      <div class="relative shrink-0">
        <div class={`w-14 h-14 rounded-full p-1 shadow-2xl ${londonHour >= 20 || londonHour < 6 ? "bg-indigo-500/20" : "bg-slate-100"}`}>
          <div class={`w-full h-full rounded-full flex items-center justify-center text-white font-black text-xl border-2 ${londonHour >= 20 || londonHour < 6 ? "bg-indigo-500 border-indigo-400" : "bg-indigo-600 border-indigo-500"}`}>
            {username.charAt(0).toUpperCase()}
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch gap-3">
      <div class={`flex items-center gap-3 bg-gradient-to-br ${clockGradient} px-5 py-2.5 rounded-2xl shadow-xl border border-white/10`}>
        <span class="text-xl">🇬🇧</span>
        <div class="border-l border-white/20 pl-3">
          <p class="text-[9px] font-black uppercase text-white/70 mb-1">London</p>
          <p class="text-xl font-black text-white tracking-tighter">
            <LiveClock client:visible timeZone="Europe/London" />
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 bg-slate-900 px-5 py-2.5 rounded-2xl border border-white/10">
        <span class="text-xl text-white">🇲🇽</span>
        <div class="border-l border-white/20 pl-3">
          <p class="text-[9px] font-black uppercase text-white mb-1">GDL</p>
          <p class="text-xl font-black text-white tracking-tighter">
            <LiveClock client:visible timeZone="America/Mexico_City" />
          </p>
        </div>
      </div>
    </div>
  </div>
</header>
