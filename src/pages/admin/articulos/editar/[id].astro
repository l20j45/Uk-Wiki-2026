---
import Layout from "@layout/Layout.astro";

import {updateArticle, findOneArticle} from "@lib/index";

import WikiEditor from "@components/WikiEditor";

const { id } = Astro.params;
const wikiId = parseInt(id || "");

if (isNaN(wikiId)) return Astro.redirect("/admin");

let articleData = await findOneArticle(wikiId);

if (!articleData) return Astro.redirect("/admin?error=article_not_found");

let message = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const newValues = {
    id: wikiId,
    title: formData.get("title")?.toString(),
    description: formData.get("description")?.toString(),
    pubDate: formData.get("pubDate")?.toString(),
    category: formData.get("category")?.toString() as "admin" | "user",
    importance: formData.get("importance")?.toString(),
    image: formData.get("image")?.toString(),
    isUrgent: formData.get("isUrgent")?.toString(),
    content: formData.get("content")?.toString(),

  };

  try {
    const result = await updateArticle(newValues);

    if (result.length === 0) {
      message = "No se encontró el artículo para actualizar.";
    } else {
          articleData = await findOneArticle(wikiId);
      message = "Artículo actualizado exitosamente.";
    }

    // return Astro.redirect("/admin?success=user_updated");
  } catch (e) {
    message = "Error al actualizar los datos en la base de datos.";
  }
}
---

<Layout title="Nueva Wiki | Admin">
  <main class="max-w-5xl mx-auto px-6 py-12">
    <header class="mb-10">
      <a
        href="/admin"
        class="text-[10px] font-black uppercase text-indigo-600 tracking-widest mb-4 block"
        >← Panel</a
      >
      <h1 class="text-3xl font-black text-slate-900 leading-tight">
        Redactar Guía de Viaje
      </h1>
    </header>

    <form method="POST">
      <WikiEditor client:only="react" initialData={articleData} />
    </form>
  </main>
</Layout>
