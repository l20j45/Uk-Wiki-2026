---
import Layout from "@layout/Layout.astro";
import DailySchedule from "@components/ui/itinerario/itinerario.astro";
import DualClock from "@components/ui/index/dualClock.astro";
import SeccionesInicial from "@components/ui/index/seccionesInicial.astro";

import { getUserLogged } from "@lib/getUser";
import { getLondonInfo } from "@lib/time/getLondonInfo";

const london = getLondonInfo();
const data = await getUserLogged(Astro);

const section = [
  {
    url: "/blog",
    text: "Wiki de IA",
    icon: "📚",
    description: "Módulos y lecturas del curso.",
  },
  {
    url: "/preparacion",
    text: "Checklist",
    icon: "🧳",
    description: "Maleta y documentos listos.",
  },
  {
    url: "/directorio",
    text: "Compañeros",
    icon: "👥",
    description: "Directorio de personas.",
  },
  {
    url: "/primerDia",
    text: "primer Dia",
    icon: "📅",
    description: "Que hacer llegando el primer dia",
  },
];
---

<Layout title="Dashboard | UK 2026">
  <main class="max-w-2xl mx-auto px-6 pb-24">
    <DualClock
      greeting={london.greeting}
      username={data?.username || "Explorer"}
      headerClass={london.headerClass}
      accentColor={london.accentColor}
      clockGradient={london.clockGradient}
      londonHour={london.londonHour}
    />
    {
      data?.username && (
        <>
          <div class="mt-12 mb-12 transform hover:scale-[1.02] transition-transform duration-300">
            <DailySchedule />
          </div>

          <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">
            Recursos Principales
          </h2>

          <div class="grid grid-cols-2 gap-4">
            {section.map((item) => (
              <SeccionesInicial
                url={item.url}
                text={item.text}
                description={item.description}
                icon={item.icon}
              />
            ))}
          </div>
        </>
      )
    }
    <div
      class="mt-12 p-6 bg-slate-900 rounded-[2rem] text-white overflow-hidden relative"
    >
      <div class="relative z-10">
        <h3 class="text-xl font-bold mb-2">Preguntas Frecuentes</h3>

        <a
          href="/ayuda"
          class="inline-block bg-white text-slate-900 px-6 py-3 rounded-full font-bold text-sm hover:bg-indigo-50 transition-colors"
        >
          Preguntas Frecuentes
        </a>
      </div>
      <div
        class="absolute -right-10 -bottom-10 w-40 h-40 bg-indigo-600 rounded-full blur-3xl opacity-50"
      >
      </div>
    </div>
    <div
      class="mt-12 p-6 bg-slate-900 rounded-[2rem] text-white overflow-hidden relative"
    >
      <div class="relative z-10">
        <h3 class="text-xl font-bold mb-2">¿Necesitas ayuda?</h3>
        <p class="text-slate-400 text-sm mb-4">
          Accede a los números de emergencia y soporte de la UdeG.
        </p>
        <a
          href="/sos"
          class="inline-block bg-white text-slate-900 px-6 py-3 rounded-full font-bold text-sm hover:bg-indigo-50 transition-colors"
        >
          Contactar Soporte
        </a>
      </div>
      <div
        class="absolute -right-10 -bottom-10 w-40 h-40 bg-indigo-600 rounded-full blur-3xl opacity-50"
      >
      </div>
    </div>
  </main>
</Layout>
