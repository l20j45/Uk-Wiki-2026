---
const hasSession = Astro.cookies.has("user_session");
const user = Astro.locals.user;
import PanicButton from "@components/PanicButton.jsx";
---

<nav
  class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200 px-4 md:px-6 py-3"
>
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <a href="/" class="flex items-center gap-2">
      <img src="/icon.svg" class="w-8 h-8" alt="Logo" />
      <span
        class="hidden sm:inline font-extrabold tracking-tight text-xl bg-clip-text text-transparent bg-gradient-to-r from-indigo-600 to-violet-600"
      >
        UK 2026
      </span>
    </a>

    <div class="flex items-center gap-4">
      <div class="hidden md:flex items-center gap-6 mr-4">
        {
          hasSession && user ? (
            <>
              <a
                href="/perfil/"
                class="text-sm font-bold text-slate-600 hover:text-indigo-600"
              >
                Mi perfil
              </a>
              <a
                href={`/usuario/${user.username}`}
                class="text-sm font-bold text-slate-600 hover:text-indigo-600"
              >
                Mi tarjeta
              </a>
              {user.isAdmin === 1 && (
                <a
                  href="/admin/"
                  class="text-sm font-bold text-slate-600 hover:text-indigo-600"
                >
                  Dashboard
                </a>
              )}

              <form method="POST" action="/api/logout" style="display:inline">
                <button
                  type="submit"
                  class="px-4 py-2 bg-rose-50 text-rose-600 rounded-xl text-sm font-bold hover:bg-rose-100 transition-colors"
                >
                  Salir
                </button>
              </form>
            </>
          ) : (
            <a
              href="/login"
              class="px-5 py-2 text-sm font-bold text-white bg-green-600 rounded-full hover:bg-green-700 transition-all"
            >
              Inicia Sesión
            </a>
          )
        }
      </div>

      <PanicButton client:visible />

      <button
        id="menu-toggle"
        class="md:hidden p-2 text-slate-600 focus:outline-none"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-7 w-7"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden mt-4 pb-4 space-y-4 border-t border-slate-100 pt-4 text-center"
  >
    {
      hasSession && user ? (
        <div class="flex flex-col gap-4">
          <a href="/" class="text-base font-bold text-slate-600">
            Inicio
          </a>
          <a href="/perfil/" class="text-base font-bold text-slate-600">
            Mi perfil
          </a>
          <a
            href={`/usuario/${user.username}`}
            class="text-base font-bold text-slate-600"
          >
            Mi tarjeta
          </a>
          {user.isAdmin === 1 && (
            <a href="/admin/" class="text-base font-bold text-slate-600">
              Dashboard
            </a>
          )}
          <form method="POST" action="/api/logout">
            <button
              type="submit"
              class="mx-auto w-2/3 px-4 py-2 bg-rose-50 text-rose-600 rounded-xl font-bold"
            >
              Cerrar Sesión
            </button>
          </form>
        </div>
      ) : (
        <a
          href="/login"
          class="block mx-auto w-2/3 px-4 py-2 font-bold text-white bg-green-600 rounded-full"
        >
          Inicia Sesión
        </a>
      )
    }
  </div>
</nav>
