---
import BackToTop from "../components/BackToTop.astro";
import Header from "./header.astro";
import Footer from "./footer.astro";
import ButtonPanicBotton from "./buttonPanicBotton.astro";

import { Toaster } from "sonner";
import { pwaInfo } from "virtual:pwa-info";

import "@styles/global.css";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="theme-color" content="#4f46e5" />

    <!-- ✅ FIX: Agregar más tamaños para mejor compatibilidad iOS/Android -->
    <link rel="apple-touch-icon" href="/icon512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="UK Wiki" />

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

    <!-- ✅ FIX: Script del SW en el <head> para registrarlo lo antes posible -->
    {
      pwaInfo?.registerSW?.scriptTag && (
        <Fragment set:html={pwaInfo.registerSW.scriptTag} />
      )
    }
  </head>

  <body
    class="bg-slate-50 text-slate-900 font-['Inter',sans-serif] antialiased"
  >
    <Toaster client:load richColors position="top-right" />

    <Header />

    <main>
      <slot />
    </main>

    <ButtonPanicBotton />

    <BackToTop />

    <Footer />

    <script>
      import { registerSW } from "virtual:pwa-register";
      import { toast } from "sonner";

      // 1. Menú móvil con accesibilidad
      const menuToggle = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");

      menuToggle?.addEventListener("click", () => {
        const isHidden = mobileMenu?.classList.toggle("hidden");
        // ✅ FIX: Actualizar aria-expanded para accesibilidad
        menuToggle.setAttribute("aria-expanded", String(!isHidden));
      });

      // ✅ FIX: Cerrar menú al hacer click fuera
      document.addEventListener("click", (e) => {
        if (
          !mobileMenu?.classList.contains("hidden") &&
          !menuToggle?.contains(e.target as Node) &&
          !mobileMenu?.contains(e.target as Node)
        ) {
          mobileMenu?.classList.add("hidden");
          menuToggle?.setAttribute("aria-expanded", "false");
        }
      });

      // 2. Service Worker
      if ("serviceWorker" in navigator) {
        const updateSW = registerSW({
          immediate: true,
          onRegisteredSW(swUrl, r) {
            if (r) {
              // Verificación periódica cada hora solo si hay conexión
              setInterval(async () => {
                if (r.installing || !navigator.onLine) return;
                await r.update();
              }, 3_600_000);
            }
          },
          onNeedRefresh() {
            toast("Nueva versión disponible 🚀", {
              duration: Infinity,
              action: {
                label: "Actualizar",
                onClick: () => updateSW(true),
              },
              // ✅ FIX: Opción de cerrar el toast sin actualizar
              cancel: {
                label: "Ahora no",
                onClick: () => {},
              },
            });
          },
          onOfflineReady() {
            toast.success("📵 Disponible sin conexión", {
              description: "Tu guía de Inglaterra está guardada.",
              // ✅ FIX: Duración razonable, no Infinity
              duration: 5000,
            });
          },
          // ✅ FIX: Manejar errores del SW
          onRegisterError(error) {
            console.error("Error registrando Service Worker:", error);
          },
        });
      }
    </script>
  </body>
</html>
